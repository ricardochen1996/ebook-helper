<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBookTitle"
            style="@style/Text.ReadAsk.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/book_unknown" />

        <ImageButton
            android:id="@+id/btnEditTitle"
            style="@style/Widget.ReadAsk.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:contentDescription="@string/panel_edit_title"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/btnClose"
            style="@style/Widget.ReadAsk.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:contentDescription="@string/panel_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_page"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/Text.ReadAsk.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_page_label"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPagePreview"
            style="@style/Text.ReadAsk.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPageToggle"
            style="@style/Text.ReadAsk.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:padding="4dp"
            android:text="@string/panel_expand"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowScreenshot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbScreenshot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/ink"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="4dp"
            android:text="@string/panel_attach_screenshot"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvScreenshotStatus"
            style="@style/Text.ReadAsk.Muted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/panel_screenshot_missing"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tvStatus"
        style="@style/Text.ReadAsk.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/panel_ready" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="@string/panel_question_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="1"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnVoice"
            style="@style/Widget.ReadAsk.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="6dp"
            android:contentDescription="@string/panel_voice"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/btnAsk"
            style="@style/Widget.ReadAsk.IconButton.Primary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="6dp"
            android:contentDescription="@string/panel_ask"
            android:src="@drawable/ic_send" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnTts"
            style="@style/Widget.ReadAsk.IconButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="@string/panel_tts_off"
            android:src="@drawable/ic_volume_off" />

        <ImageButton
            android:id="@+id/btnNewSession"
            style="@style/Widget.ReadAsk.IconButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:contentDescription="@string/panel_new_session"
            android:src="@drawable/ic_add" />

        <ImageButton
            android:id="@+id/btnHistory"
            style="@style/Widget.ReadAsk.IconButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:contentDescription="@string/panel_history"
            android:src="@drawable/ic_history" />
    </LinearLayout>

</LinearLayout>
