<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBookTitle"
            style="@style/Text.ReadAsk.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/book_unknown" />

        <TextView
            android:id="@+id/btnEditTitle"
            style="@style/Widget.ReadAsk.PlainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/panel_edit" />

        <TextView
            android:id="@+id/btnClose"
            style="@style/Widget.ReadAsk.PlainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/panel_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_page"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/Text.ReadAsk.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_page_label" />

        <TextView
            android:id="@+id/tvPagePreview"
            style="@style/Text.ReadAsk.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPageToggle"
            style="@style/Text.ReadAsk.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/panel_expand" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tvStatus"
        style="@style/Text.ReadAsk.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/panel_ready" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="@string/panel_question_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="1"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnVoice"
            style="@style/Widget.ReadAsk.PlainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/panel_voice" />

        <Button
            android:id="@+id/btnAsk"
            style="@style/Widget.ReadAsk.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/panel_ask" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTts"
            style="@style/Widget.ReadAsk.PlainButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/panel_tts_on" />

        <TextView
            android:id="@+id/btnStop"
            style="@style/Widget.ReadAsk.PlainButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:text="@string/panel_stop" />

        <TextView
            android:id="@+id/btnNewSession"
            style="@style/Widget.ReadAsk.PlainButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:text="@string/panel_new_session" />

        <TextView
            android:id="@+id/btnHistory"
            style="@style/Widget.ReadAsk.PlainButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:text="@string/panel_history" />
    </LinearLayout>

</LinearLayout>
