<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                style="@style/Widget.ReadAsk.PlainButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back" />

            <TextView
                style="@style/Text.ReadAsk.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:text="@string/qr_config_title" />
        </LinearLayout>

        <TextView
            style="@style/Text.ReadAsk.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/qr_config_hint" />

        <ImageView
            android:id="@+id/ivQr"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="16dp"
            android:background="@color/paper"
            android:contentDescription="@string/qr_config_title"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/Text.ReadAsk.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/qr_config_waiting" />

        <TextView
            style="@style/Text.ReadAsk.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/qr_config_url_label" />

        <TextView
            android:id="@+id/tvUrl"
            style="@style/Text.ReadAsk.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true" />

        <TextView
            style="@style/Text.ReadAsk.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/qr_config_phone_hint" />

        <TextView
            android:id="@+id/btnCancel"
            style="@style/Widget.ReadAsk.PlainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/qr_config_cancel" />

    </LinearLayout>
</ScrollView>
